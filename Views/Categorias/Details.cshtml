@model Categoria
@{
    ViewData["Title"] = Model.Nombre;
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
        <h1 class="h3 mb-0">@Model.Nombre</h1>
        <span class="text-muted">@(Model.Descripcion ?? "Sin descripción")</span>
    </div>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.CategoriaId" class="btn btn-outline-secondary"><i class="bi bi-pencil"></i> Editar</a>
        <a asp-action="Index" class="btn btn-link">Volver al listado</a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-white fw-semibold">Libros en esta categoría (@Model.Libros.Count)</div>
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light"><tr><th>Título</th><th>Autor</th><th>Año</th><th class="text-center">Ejemplares</th></tr></thead>
            <tbody>
                @foreach (var libro in Model.Libros.OrderBy(l => l.Titulo))
                {
                    <tr>
                        <td><a asp-controller="Libros" asp-action="Details" asp-route-id="@libro.LibroId">@libro.Titulo</a></td>
                        <td>@libro.Autor?.Nombre</td>
                        <td>@libro.AnioPublicacion</td>
                        <td class="text-center">@libro.Ejemplares</td>
                    </tr>
                }
                @if (!Model.Libros.Any())
                {
                    <tr><td colspan="4" class="text-center text-muted py-4">No hay libros en esta categoría.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
