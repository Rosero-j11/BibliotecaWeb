@model Prestamo
@{
    ViewData["Title"] = "Detalle del préstamo";
}

<div class="encabezado d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <h1 class="h3 mb-0">Préstamo #@Model.PrestamoId <partial name="_EstadoPrestamo" model="Model.Estado" /></h1>
    <a asp-action="Index" class="btn btn-link">Volver al listado</a>
</div>

<div class="card shadow-sm col-lg-6">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-5">Libro</dt>
            <dd class="col-sm-7"><a asp-controller="Libros" asp-action="Details" asp-route-id="@Model.LibroId">@Model.Libro?.Titulo</a></dd>
            <dt class="col-sm-5">Autor</dt>
            <dd class="col-sm-7">@Model.Libro?.Autor?.Nombre</dd>
            <dt class="col-sm-5">Socio</dt>
            <dd class="col-sm-7"><a asp-controller="Socios" asp-action="Details" asp-route-id="@Model.SocioId">@Model.Socio?.Nombre</a> (@Model.Socio?.Documento)</dd>
            <dt class="col-sm-5">Fecha de préstamo</dt>
            <dd class="col-sm-7">@Model.FechaPrestamo.ToString("dd/MM/yyyy")</dd>
            <dt class="col-sm-5">Fecha límite</dt>
            <dd class="col-sm-7">@Model.FechaLimite.ToString("dd/MM/yyyy")</dd>
            <dt class="col-sm-5">Fecha de devolución</dt>
            <dd class="col-sm-7">@(Model.FechaDevolucion?.ToString("dd/MM/yyyy") ?? "Pendiente")</dd>
        </dl>
    </div>
    @if (Model.FechaDevolucion == null)
    {
        <div class="card-footer bg-white">
            <form asp-action="Devolver" asp-route-id="@Model.PrestamoId" method="post">
                <button type="submit" class="btn btn-success"><i class="bi bi-box-arrow-in-left"></i> Registrar devolución</button>
            </form>
        </div>
    }
</div>
