@model InicioViewModel
@{
    ViewData["Title"] = "Inicio";
}

<section class="portada mb-4">
    <p class="lema mb-1">"Un libro abierto es un cerebro que habla."</p>
    <h1 class="mb-2">Panel de la biblioteca</h1>
    <p class="mb-4 opacity-75">
        <i class="bi bi-calendar3 me-1"></i> @DateTime.Today.ToString("dddd, d 'de' MMMM 'de' yyyy")
    </p>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-light" asp-controller="Prestamos" asp-action="Create"><i class="bi bi-arrow-left-right"></i> Registrar préstamo</a>
        <a class="btn btn-outline-light" asp-controller="Libros" asp-action="Create"><i class="bi bi-journal-plus"></i> Nuevo libro</a>
        <a class="btn btn-outline-light" asp-controller="Socios" asp-action="Create"><i class="bi bi-person-plus"></i> Nuevo socio</a>
    </div>
</section>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <a class="text-decoration-none" asp-controller="Libros" asp-action="Index">
            <div class="card tarjeta-resumen h-100" style="--color-tarjeta:#7a2e2a">
                <div class="card-body d-flex justify-content-between align-items-start">
                    <div>
                        <div class="etiqueta">Títulos</div>
                        <div class="valor">@Model.TotalLibros</div>
                        <div class="text-muted small">@Model.TotalEjemplares ejemplares</div>
                    </div>
                    <span class="icono"><i class="bi bi-journal-bookmark-fill"></i></span>
                </div>
            </div>
        </a>
    </div>
    <div class="col-6 col-lg-3">
        <a class="text-decoration-none" asp-controller="Socios" asp-action="Index">
            <div class="card tarjeta-resumen h-100" style="--color-tarjeta:#8a6a2b">
                <div class="card-body d-flex justify-content-between align-items-start">
                    <div>
                        <div class="etiqueta">Socios</div>
                        <div class="valor">@Model.TotalSocios</div>
                        <div class="text-muted small">registrados</div>
                    </div>
                    <span class="icono"><i class="bi bi-people-fill"></i></span>
                </div>
            </div>
        </a>
    </div>
    <div class="col-6 col-lg-3">
        <a class="text-decoration-none" asp-controller="Prestamos" asp-action="Index" asp-route-estado="Activo">
            <div class="card tarjeta-resumen h-100" style="--color-tarjeta:#2f5d4e">
                <div class="card-body d-flex justify-content-between align-items-start">
                    <div>
                        <div class="etiqueta">Préstamos activos</div>
                        <div class="valor">@Model.PrestamosActivos</div>
                        <div class="text-muted small">dentro del plazo</div>
                    </div>
                    <span class="icono"><i class="bi bi-book-half"></i></span>
                </div>
            </div>
        </a>
    </div>
    <div class="col-6 col-lg-3">
        <a class="text-decoration-none" asp-controller="Prestamos" asp-action="Index" asp-route-estado="Vencido">
            <div class="card tarjeta-resumen h-100" style="--color-tarjeta:#b0352b">
                <div class="card-body d-flex justify-content-between align-items-start">
                    <div>
                        <div class="etiqueta">Préstamos vencidos</div>
                        <div class="valor @(Model.PrestamosVencidos > 0 ? "text-danger" : "")">@Model.PrestamosVencidos</div>
                        <div class="text-muted small">por devolver</div>
                    </div>
                    <span class="icono"><i class="bi bi-alarm-fill"></i></span>
                </div>
            </div>
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header fw-semibold"><i class="bi bi-alarm me-1"></i> Préstamos vencidos</div>
            <div class="card-body p-0">
                @if (!Model.Vencidos.Any())
                {
                    <p class="text-muted p-4 mb-0 text-center"><i class="bi bi-emoji-smile fs-4 d-block mb-1"></i> No hay préstamos vencidos.</p>
                }
                else
                {
                    <table class="table align-middle mb-0">
                        <thead><tr><th class="ps-3">Libro</th><th>Socio</th><th>Venció</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var p in Model.Vencidos)
                            {
                                <tr>
                                    <td class="ps-3"><a asp-controller="Libros" asp-action="Details" asp-route-id="@p.LibroId">@p.Libro?.Titulo</a></td>
                                    <td>@p.Socio?.Nombre</td>
                                    <td class="text-danger">@p.FechaLimite.ToString("dd/MM/yyyy")<br /><small>@((DateTime.Today - p.FechaLimite).Days) día(s) de retraso</small></td>
                                    <td class="text-end pe-3">
                                        <form asp-controller="Prestamos" asp-action="Devolver" asp-route-id="@p.PrestamoId" asp-route-volverA="/" method="post">
                                            <button type="submit" class="btn btn-sm btn-outline-success"><i class="bi bi-box-arrow-in-left"></i> Devolver</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
                <span><i class="bi bi-clock-history me-1"></i> Últimos préstamos</span>
                <a asp-controller="Prestamos" asp-action="Index" class="small" style="font-family: var(--bs-body-font-family)">Ver todos <i class="bi bi-arrow-right"></i></a>
            </div>
            <div class="card-body p-0">
                <table class="table align-middle mb-0">
                    <thead><tr><th class="ps-3">Libro</th><th>Socio</th><th>Fecha</th><th>Estado</th></tr></thead>
                    <tbody>
                        @foreach (var p in Model.Recientes)
                        {
                            <tr>
                                <td class="ps-3"><a asp-controller="Prestamos" asp-action="Details" asp-route-id="@p.PrestamoId">@p.Libro?.Titulo</a></td>
                                <td>@p.Socio?.Nombre</td>
                                <td>@p.FechaPrestamo.ToString("dd/MM/yyyy")</td>
                                <td><partial name="_EstadoPrestamo" model="p.Estado" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
