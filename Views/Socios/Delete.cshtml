@model Socio
@{
    ViewData["Title"] = "Eliminar socio";
}

<h1 class="h3 mb-4 encabezado">Eliminar socio</h1>

<div class="card shadow-sm col-lg-6">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">Nombre</dt>
            <dd class="col-sm-8">@Model.Nombre</dd>
            <dt class="col-sm-4">Documento</dt>
            <dd class="col-sm-8">@Model.Documento</dd>
            <dt class="col-sm-4">Correo</dt>
            <dd class="col-sm-8">@Model.Email</dd>
            <dt class="col-sm-4">Préstamos</dt>
            <dd class="col-sm-8">@Model.Prestamos.Count</dd>
        </dl>
    </div>
    <div class="card-footer bg-white">
        @if (Model.Prestamos.Any())
        {
            <div class="alert alert-warning mb-3">Este socio tiene préstamos en su historial, por eso no se puede eliminar.</div>
            <a asp-action="Index" class="btn btn-secondary">Volver</a>
        }
        else
        {
            <p class="mb-3">¿Seguro que desea eliminar este socio? Esta acción no se puede deshacer.</p>
            <form asp-action="Delete">
                <input type="hidden" asp-for="SocioId" />
                <button type="submit" class="btn btn-danger">Eliminar</button>
                <a asp-action="Index" class="btn btn-link">Cancelar</a>
            </form>
        }
    </div>
</div>
