@model Socio
@{
    ViewData["Title"] = "Nuevo socio";
}

<h1 class="h3 mb-4 encabezado">Nuevo socio</h1>

<div class="card shadow-sm col-lg-8">
    <div class="card-body">
        <form asp-action="Create">
            <partial name="_Form" model="Model" />
            <button type="submit" class="btn btn-primary">Guardar</button>
            <a asp-action="Index" class="btn btn-link">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
